{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AeroGallery",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 460,
        "center": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true,
        "theme": "Light",
        "transparent": true,
        "backgroundColor": "#00000000",
        "shadow": true
      }
    ]
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/shell.nsh"
      }
    }
  }
}
