!macro NSIS_HOOK_POSTINSTALL
  WriteRegStr HKCU "Software\Classes\AeroGallery.Picture" "" "AeroGallery picture"
  WriteRegStr HKCU "Software\Classes\AeroGallery.Picture\DefaultIcon" "" '$\"$INSTDIR\${MAINBINARYNAME}.exe$\",0'
  WriteRegStr HKCU "Software\Classes\AeroGallery.Picture\shell\open\command" "" '$\"$INSTDIR\${MAINBINARYNAME}.exe$\" $\"%1$\"'
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe" "FriendlyAppName" "AeroGallery"
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\shell\open\command" "" '$\"$INSTDIR\${MAINBINARYNAME}.exe$\" $\"%1$\"'
  WriteRegStr HKCU "Software\AeroGallery\Capabilities" "ApplicationName" "AeroGallery"
  WriteRegStr HKCU "Software\AeroGallery\Capabilities" "ApplicationDescription" "Local photo gallery and viewer"
  WriteRegStr HKCU "Software\RegisteredApplications" "AeroGallery" "Software\AeroGallery\Capabilities"
  WriteRegStr HKCU "Software\Classes\.jpg\OpenWithProgids" "AeroGallery.Picture" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".jpg" ""
  WriteRegStr HKCU "Software\AeroGallery\Capabilities\FileAssociations" ".jpg" "AeroGallery.Picture"
  WriteRegStr HKCU "Software\Classes\.jpeg\OpenWithProgids" "AeroGallery.Picture" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".jpeg" ""
  WriteRegStr HKCU "Software\AeroGallery\Capabilities\FileAssociations" ".jpeg" "AeroGallery.Picture"
  WriteRegStr HKCU "Software\Classes\.png\OpenWithProgids" "AeroGallery.Picture" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".png" ""
  WriteRegStr HKCU "Software\AeroGallery\Capabilities\FileAssociations" ".png" "AeroGallery.Picture"
  WriteRegStr HKCU "Software\Classes\.webp\OpenWithProgids" "AeroGallery.Picture" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".webp" ""
  WriteRegStr HKCU "Software\AeroGallery\Capabilities\FileAssociations" ".webp" "AeroGallery.Picture"
  WriteRegStr HKCU "Software\Classes\.gif\OpenWithProgids" "AeroGallery.Picture" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".gif" ""
  WriteRegStr HKCU "Software\AeroGallery\Capabilities\FileAssociations" ".gif" "AeroGallery.Picture"
  WriteRegStr HKCU "Software\Classes\.bmp\OpenWithProgids" "AeroGallery.Picture" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".bmp" ""
  WriteRegStr HKCU "Software\AeroGallery\Capabilities\FileAssociations" ".bmp" "AeroGallery.Picture"
  WriteRegStr HKCU "Software\Classes\.tif\OpenWithProgids" "AeroGallery.Picture" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".tif" ""
  WriteRegStr HKCU "Software\AeroGallery\Capabilities\FileAssociations" ".tif" "AeroGallery.Picture"
  WriteRegStr HKCU "Software\Classes\.tiff\OpenWithProgids" "AeroGallery.Picture" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".tiff" ""
  WriteRegStr HKCU "Software\AeroGallery\Capabilities\FileAssociations" ".tiff" "AeroGallery.Picture"
  WriteRegStr HKCU "Software\Classes\.ico\OpenWithProgids" "AeroGallery.Picture" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".ico" ""
  WriteRegStr HKCU "Software\AeroGallery\Capabilities\FileAssociations" ".ico" "AeroGallery.Picture"
  WriteRegStr HKCU "Software\Classes\.tga\OpenWithProgids" "AeroGallery.Picture" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".tga" ""
  WriteRegStr HKCU "Software\AeroGallery\Capabilities\FileAssociations" ".tga" "AeroGallery.Picture"
  WriteRegStr HKCU "Software\Classes\.qoi\OpenWithProgids" "AeroGallery.Picture" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".qoi" ""
  WriteRegStr HKCU "Software\AeroGallery\Capabilities\FileAssociations" ".qoi" "AeroGallery.Picture"
  WriteRegStr HKCU "Software\Classes\.pnm\OpenWithProgids" "AeroGallery.Picture" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".pnm" ""
  WriteRegStr HKCU "Software\AeroGallery\Capabilities\FileAssociations" ".pnm" "AeroGallery.Picture"
  WriteRegStr HKCU "Software\Classes\.ppm\OpenWithProgids" "AeroGallery.Picture" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".ppm" ""
  WriteRegStr HKCU "Software\AeroGallery\Capabilities\FileAssociations" ".ppm" "AeroGallery.Picture"
  WriteRegStr HKCU "Software\Classes\.pgm\OpenWithProgids" "AeroGallery.Picture" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".pgm" ""
  WriteRegStr HKCU "Software\AeroGallery\Capabilities\FileAssociations" ".pgm" "AeroGallery.Picture"
  WriteRegStr HKCU "Software\Classes\.pbm\OpenWithProgids" "AeroGallery.Picture" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".pbm" ""
  WriteRegStr HKCU "Software\AeroGallery\Capabilities\FileAssociations" ".pbm" "AeroGallery.Picture"
  IfSilent browse_done
  MessageBox MB_YESNO|MB_DEFBUTTON2 "Add Browse with AeroGallery to the folder context menu?" IDNO browse_remove
  WriteRegStr HKCU "Software\Classes\Directory\shell\AeroGallery.Browse" "" "Browse with AeroGallery"
  WriteRegStr HKCU "Software\Classes\Directory\shell\AeroGallery.Browse\command" "" '$\"$INSTDIR\${MAINBINARYNAME}.exe$\" $\"%1$\"'
  Goto browse_done
  browse_remove:
  DeleteRegKey HKCU "Software\Classes\Directory\shell\AeroGallery.Browse"
  browse_done:
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
  DeleteRegValue HKCU "Software\Classes\.jpg\OpenWithProgids" "AeroGallery.Picture"
  DeleteRegKey /ifempty HKCU "Software\Classes\.jpg\OpenWithProgids"
  DeleteRegValue HKCU "Software\Classes\.jpeg\OpenWithProgids" "AeroGallery.Picture"
  DeleteRegKey /ifempty HKCU "Software\Classes\.jpeg\OpenWithProgids"
  DeleteRegValue HKCU "Software\Classes\.png\OpenWithProgids" "AeroGallery.Picture"
  DeleteRegKey /ifempty HKCU "Software\Classes\.png\OpenWithProgids"
  DeleteRegValue HKCU "Software\Classes\.webp\OpenWithProgids" "AeroGallery.Picture"
  DeleteRegKey /ifempty HKCU "Software\Classes\.webp\OpenWithProgids"
  DeleteRegValue HKCU "Software\Classes\.gif\OpenWithProgids" "AeroGallery.Picture"
  DeleteRegKey /ifempty HKCU "Software\Classes\.gif\OpenWithProgids"
  DeleteRegValue HKCU "Software\Classes\.bmp\OpenWithProgids" "AeroGallery.Picture"
  DeleteRegKey /ifempty HKCU "Software\Classes\.bmp\OpenWithProgids"
  DeleteRegValue HKCU "Software\Classes\.tif\OpenWithProgids" "AeroGallery.Picture"
  DeleteRegKey /ifempty HKCU "Software\Classes\.tif\OpenWithProgids"
  DeleteRegValue HKCU "Software\Classes\.tiff\OpenWithProgids" "AeroGallery.Picture"
  DeleteRegKey /ifempty HKCU "Software\Classes\.tiff\OpenWithProgids"
  DeleteRegValue HKCU "Software\Classes\.ico\OpenWithProgids" "AeroGallery.Picture"
  DeleteRegKey /ifempty HKCU "Software\Classes\.ico\OpenWithProgids"
  DeleteRegValue HKCU "Software\Classes\.tga\OpenWithProgids" "AeroGallery.Picture"
  DeleteRegKey /ifempty HKCU "Software\Classes\.tga\OpenWithProgids"
  DeleteRegValue HKCU "Software\Classes\.qoi\OpenWithProgids" "AeroGallery.Picture"
  DeleteRegKey /ifempty HKCU "Software\Classes\.qoi\OpenWithProgids"
  DeleteRegValue HKCU "Software\Classes\.pnm\OpenWithProgids" "AeroGallery.Picture"
  DeleteRegKey /ifempty HKCU "Software\Classes\.pnm\OpenWithProgids"
  DeleteRegValue HKCU "Software\Classes\.ppm\OpenWithProgids" "AeroGallery.Picture"
  DeleteRegKey /ifempty HKCU "Software\Classes\.ppm\OpenWithProgids"
  DeleteRegValue HKCU "Software\Classes\.pgm\OpenWithProgids" "AeroGallery.Picture"
  DeleteRegKey /ifempty HKCU "Software\Classes\.pgm\OpenWithProgids"
  DeleteRegValue HKCU "Software\Classes\.pbm\OpenWithProgids" "AeroGallery.Picture"
  DeleteRegKey /ifempty HKCU "Software\Classes\.pbm\OpenWithProgids"
  DeleteRegKey HKCU "Software\Classes\AeroGallery.Picture"
  DeleteRegKey HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe"
  DeleteRegKey HKCU "Software\Classes\Directory\shell\AeroGallery.Browse"
  DeleteRegValue HKCU "Software\RegisteredApplications" "AeroGallery"
  DeleteRegKey HKCU "Software\AeroGallery\Capabilities"
  DeleteRegKey /ifempty HKCU "Software\AeroGallery"
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend
